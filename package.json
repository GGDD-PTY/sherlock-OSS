{
  "name": "sherlock",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.22.1 <25.0.0"
  },
  "description": "Sherlock project",
  "workspaces": [
    "sherlock/app",
    "sherlock/app/mog-sidecar"
  ],
  "scripts": {
    "dev": "\"$npm_execpath\" --cwd=sherlock/app run dev",
    "dev:local": "\"$npm_execpath\" --cwd=sherlock/app run dev:local",
    "convex:local": "\"$npm_execpath\" --cwd=sherlock/app run convex:local",
    "seed:local": "\"$npm_execpath\" --cwd=sherlock/app run seed:local",
    "seed:company": "\"$npm_execpath\" --cwd=sherlock/app run seed:company",
    "lint": "\"$npm_execpath\" --cwd=sherlock/app run lint",
    "lint:ox": "oxlint --type-aware",
    "typecheck": "\"$npm_execpath\" --cwd=sherlock/app run typecheck:all",
    "test": "\"$npm_execpath\" --cwd=sherlock/app run test:run",
    "build": "\"$npm_execpath\" --cwd=sherlock/app run build",
    "start": "\"$npm_execpath\" --cwd=sherlock/app run start",
    "viewer:assets": "\"$npm_execpath\" --cwd=sherlock/app run viewer:assets",
    "secrets:scan": "gitleaks git . --redact --no-banner && gitleaks git . --redact --no-banner --pre-commit",
    "secrets:scan:workspace": "gitleaks dir . --redact --no-banner",
    "effect:status": "\"$npm_execpath\" scripts/effect-status.mjs",
    "screens:sitio": "node scripts/site-screenshots.mjs",
    "screens:sala": "node scripts/room-screenshots.mjs",
    "dead-code": "knip --no-progress",
    "verify:quick": "\"$npm_execpath\" --cwd=sherlock/app run dead-code && \"$npm_execpath\" --cwd=sherlock/app run test:run",
    "verify:gate": "\"$npm_execpath\" scripts/verify-gate.mjs",
    "verify:local": "\"$npm_execpath\" scripts/verify-local.mjs",
    "journeys:local": "\"$npm_execpath\" scripts/journeys-local.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "4.1.12",
    "knip": "6.23.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.61.1"
  },
  "overrides": {
    "protobufjs": "^7.5.5",
    "minimatch": "^9.0.7",
    "markdown-it": "14.3.3",
    "vite": "7.3.7",
    "eslint-plugin-react-hooks": "7.0.1",
    "lodash-es": "^4.18.1",
    "picomatch": "^4.0.4",
    "fast-uri": "3.1.9",
    "flatted": "^3.3.4",
    "undici": "~7.30.1",
    "smol-toml": "^1.8.0",
    "lodash": "^4.17.24",
    "yaml": "^2.8.3",
    "postcss": "^8.5.18",
    "source-map-js": "^1.2.2",
    "sharp": "^0.35.5",
    "brace-expansion": "^2.1.7",
    "ws": "^8.21.0",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17",
    "browserslist": "4.28.8"
  },
  "patchedDependencies": {
    "@mog-sdk/spreadsheet-app@0.10.8-rc.6": "patches/@mog-sdk%2Fspreadsheet-app@0.10.8-rc.6.patch",
    "convex@1.42.0": "patches/convex@1.42.0.patch"
  }
}
